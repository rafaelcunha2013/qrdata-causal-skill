{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgwvGCUDKN9jE2799Dvei","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C8SWjN8ETeRiyCCvYvp8nX","name":"Bash","input":{"command":"mkdir -p /tmp/x 2>/dev/null; cat > /private/tmp/claude-501/-private-var-folders-nt-pyxgztts10z73b0trwgt72-w0000gn-T-qrdata-bp1ev4n4-q371/9285e22f-95a3-4bfa-83d8-ec792bb9eed4/scratchpad/gb.py <<'E'\nimport numpy as np, pandas as pd\ntr=pd.read_csv('invest_email_rnd_train.csv');te=pd.read_csv('invest_email_rnd_test.csv')\nF=['age','income','insurance','invested']\ndef fit_tree(X,r,depth,minleaf=50):\n    if depth==0 or len(r)<2*minleaf: return r.mean()\n    best=None\n    for j in range(X.shape[1]):\n        qs=np.unique(np.quantile(X[:,j],np.linspace(.05,.95,19)))\n        for q in qs:\n            m=X[:,j]<=q;nl=m.sum();nr=len(r)-nl\n            if nl<minleaf or nr<minleaf: continue\n            s=r[m].sum()**2/nl+r[~m].sum()**2/nr\n            if best is None or s>best[0]: best=(s,j,q,m)\n    if best is None: return r.mean()\n    _,j,q,m=best\n    return (j,q,fit_tree(X[m],r[m],depth-1,minleaf),fit_tree(X[~m],r[~m],depth-1,minleaf))\ndef pred_tree(t,x):\n    while isinstance(t,tuple): t=t[2] if x[t[0]]<=t[1] else t[3]\n    return t\ndef gbm(X,y,n=100,lr=0.05,depth=2):\n    f0=y.mean();p=np.full(len(y),f0);ts=[]\n    for _ in range(n):\n        t=fit_tree(X,y-p,depth);ts.append(t)\n        p+=lr*np.array([pred_tree(t,x) for x in X])\n    return lambda x:f0+lr*sum(pred_tree(t,x) for t in ts)\nXt=tr[F].values;y=tr.converted.values.astype(float);w=tr.em1.values\nm1=gbm(Xt[w==1],y[w==1]);m0=gbm(Xt[w==0],y[w==0])\nx=te.loc[te.id==6958,F].values[0]\nprint(m1(x),m0(x),round(100*(m1(x)-m0(x)),2))\nE\npython -I /private/tmp/claude-501/-private-var-folders-nt-pyxgztts10z73b0trwgt72-w0000gn-T-qrdata-bp1ev4n4-q371/9285e22f-95a3-4bfa-83d8-ec792bb9eed4/scratchpad/gb.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":