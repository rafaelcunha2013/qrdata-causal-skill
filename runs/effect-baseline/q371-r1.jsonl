r.em1.values\nm1=gbm(Xt[w==1],y[w==1]);m0=gbm(Xt[w==0],y[w==0])\nx=te.loc[te.id==6958,F].values[0]\nprint(m1(x),m0(x),round(100*(m1(x)-m0(x)),2))\nE\npython -I /private/tmp/claude-501/-private-var-folders-nt-pyxgztts10z73b0trwgt72-w0000gn-T-qrdata-bp1ev4n4-q371/9285e22f-95a3-4bfa-83d8-ec792bb9eed4/scratchpad/gb.py"}}}
