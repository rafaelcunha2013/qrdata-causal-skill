umns=ca);y=p[ca]\nn=X.shape[1]\nf=lambda w:((y[pre]-X[pre]@w)**2).sum()\nr=minimize(f,np.ones(n)/n,bounds=[(0,1)]*n,constraints={'type':'eq','fun':lambda w:w.sum()-1},method='SLSQP',options={'maxiter':1000,'ftol':1e-12})\ng=y-X@r.x\nprint(r.fun,g[~pre].mean())\nE\npython $TMPDIR/a.py"}}}
