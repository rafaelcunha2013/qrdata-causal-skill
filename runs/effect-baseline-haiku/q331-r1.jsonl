{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgxjhYVPrfnApTANVfi5Q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Do8y7SHdbmHyGKYyYiuBQx","name":"Bash","input":{"command":"python -I -c \"\nimport pandas as pd, numpy as np\nimport statsmodels.api as sm\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.neighbors import NearestNeighbors\ndf=pd.read_csv('ihdp_6.csv')\nX=[f'x{i}' for i in range(1,26)]\nt=df.treatment.values; y=df.y.values; Xm=df[X].values\nprint('n treated',t.sum(),'control',(1-t).sum())\n# 1. OLS with treatment + covariates, ATT = ATE in linear model (no interactions)\nm=sm.OLS(y,sm.add_constant(np.column_stack([t,Xm]))).fit()\nprint('OLS coef', m.params[1])\n# 2. Regression imputation ATT: fit outcome model on controls, impute counterfactual for treated\nmc=sm.OLS(y[t==0],sm.add_constant(Xm[t==0])).fit()\nmu0=mc.predict(sm.add_constant(Xm[t==1],has_constant='add'))\nprint('ATT regression imputation', (y[t==1]-mu0).mean())\n# 3. Propensity IPW ATT\nps=LogisticRegression(C=1e6,max_iter=5000).fit(Xm,t).predict_proba(Xm)[:,1]\nw=ps[t==0]/(1-ps[t==0])\nprint('ATT IPW', y[t==1].mean()-np.sum(w*y[t==0])/w.sum())\n# 4. Nearest neighbor matching ATT on covariates (1:1 with replacement)\nXs=(Xm-Xm.mean(0))/Xm.std(0)\nnn=NearestNeighbors(n_neighbors=1).fit(Xs[t==0])\nd,idx=nn.kneighbors(Xs[t==1])\nprint('ATT NN match', (y[t==1]-y[t==0][idx[:,0]]).mean())\n# 5. AIPW ATT\np1=t.mean()\nmu1=sm.OLS(y[t==1],sm.add_constant(Xm[t==1])).fit().predict(sm.add_constant(Xm,has_constant='add'))\nmu0a=mc.predict(sm.add_constant(Xm,has_constant='add'))\nnum=(t*(y-mu0a)-(1-t)*ps/(1-ps)*(y-mu0a)).sum()\nprint('ATT AIPW', num/t.sum())\n# 6. Simple diff\nprint('naive', y[t==1].mean()-y[t==0].mean())\n\"\n","description":"Compute ATT under several estimators"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_in