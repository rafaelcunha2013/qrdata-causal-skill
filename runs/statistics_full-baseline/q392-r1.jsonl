estion.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GGJMGMyzLSVtJHi89oSFAv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
